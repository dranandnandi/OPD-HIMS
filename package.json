{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev:suite-admin": "npm --prefix suite-admin run dev",
    "build:suite-admin": "npm --prefix suite-admin run build",
    "test:suite": "node --test tests/suite-platform.test.mjs tests/suite-operations.test.mjs tests/suite-invitations.test.mjs",
    "test:pharmacy": "node --test tests/pharmacy-pack-units.test.mjs tests/pharmacy-dispense-price.test.mjs tests/pharmacy-loose-stock-precision.test.mjs tests/pharmacy-purchase-corrections.test.mjs tests/pharmacy-ipd-stock.test.mjs tests/pharmacy-invoice-import.test.mjs tests/pharmacy-store-migration-repair.test.mjs tests/pharmacy-invoice-pdf.test.mjs tests/pharmacy-invoice-service.test.mjs tests/pharmacy-register.test.mjs tests/billing-payments.test.mjs",
    "test:suite:contracts": "deno test --allow-env --no-lock supabase/functions/_shared/suite-contract.test.ts supabase/functions/_shared/suite-http.test.ts supabase/functions/_shared/suite-connector.test.ts supabase/functions/_shared/suite-operations.test.ts supabase/functions/_shared/suite-invitations.test.ts",
    "test:suite:runtime": "deno test --no-lock suite-integrations/tests/access-core.test.ts suite-integrations/tests/tenant-access.test.ts",
    "test:suite:workforce": "deno test --allow-env --no-lock suite-integrations/tests/workforce-edge.test.ts",
    "test:suite:runtime-node": "node --test suite-integrations/tests/runtime-node.test.mjs",
    "test:suite:bridge": "node --test suite-integrations/tests/workforce-bridge.test.mjs",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cap:init": "npx cap init",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync",
    "cap:sync:android": "npm run build && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "cap:run:android": "npm run build && npx cap run android",
    "android:build": "cd android && .\\gradlew assembleDebug",
    "android:release": "cd android && .\\gradlew assembleRelease",
    "android:clean": "cd android && .\\gradlew clean"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/dialog": "^7.0.2",
    "@capacitor/local-notifications": "^7.0.3",
    "@capacitor/push-notifications": "^7.0.3",
    "@ckeditor/ckeditor5-react": "^11.2.0",
    "@google-cloud/vision": "^5.3.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.51.0",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/react-router-dom": "^5.3.3",
    "ckeditor5": "^48.3.0",
    "date-fns": "^4.1.0",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.11.6",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.344.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.189",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^9.9.1",
    "@types/jsbarcode": "^3.11.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^1.2.0"
  }
}
