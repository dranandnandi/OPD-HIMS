# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (for backend scripts only - NEVER expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firebase Configuration (optional - for web push)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Other API Keys
VITE_GOOGLE_CLOUD_API_KEY=your-google-cloud-api-key
VITE_GEMINI_API_KEY=your-gemini-api-key

# ─── ABDM / ABHA (server-side only — set with `supabase secrets set`) ─────────
#
# These must NEVER be VITE_-prefixed. A VITE_ variable is inlined into the
# browser bundle, and the ABDM client secret in a public bundle is a reportable
# incident, not a config mistake.
#
# ABDM_ENV selects the environment and everything derived from it: gateway host,
# ABHA host, PHR host and the X-CM-ID header ('sbx' vs 'abdm'). It defaults to
# sandbox when unset or unrecognised, so a misconfigured deployment fails safe
# rather than creating real health accounts against live ABDM.
#   sandbox    -> dev.abdm.gov.in    + abhasbx.abdm.gov.in   (X-CM-ID: sbx)
#   production -> apis.abdm.gov.in   + abha.abdm.gov.in      (X-CM-ID: abdm)
ABDM_ENV=sandbox
ABDM_CLIENT_ID=your-nha-client-id
ABDM_CLIENT_SECRET=your-nha-client-secret

# Comma-separated origins allowed to call the ABDM edge functions. Leaving this
# unset logs a warning and does NOT restrict CORS — acceptable while developing,
# a security finding in production (see G-09 in the roadmap doc).
ABDM_ALLOWED_ORIGINS=https://your-app-domain.example

# Optional host overrides. Only needed if NHA moves an endpoint before this
# code is updated; ABDM_ENV already picks the correct defaults.
# ABDM_GATEWAY_BASE=https://dev.abdm.gov.in/api/hiecm
# ABDM_ABHA_BASE=https://abhasbx.abdm.gov.in/abha/api
# ABDM_PHR_BASE=https://abhasbx.abdm.gov.in/abha/api/v3/phr/web
#
# Superseded and no longer read: ABDM_BASE_URL, ABDM_X_CM_ID. X-CM-ID is now
# derived from ABDM_ENV so the two cannot drift out of step.

# Stable PDF links (see supabase/migrations/stable-opd.md)
#
# FALLBACK public prefix for /r/<token>.pdf links. Per-clinic branded domains
# are set in clinic_settings.document_link_base (manually, no UI) and take
# precedence; this value is used only for clinics that leave that column NULL.
#
# MUST include the scheme — a bare "app.example.in/r" is a relative URL, so the
# browser resolves it against the app origin and the SPA catch-all serves
# index.html instead of the document.
#
# Do NOT mark this as a secret in Netlify: secret values render as "****", and
# saving over the mask stores the mask as the value. Delete and re-create the
# variable rather than editing it.
#
# The edge functions need the same value under the un-prefixed name DOC_LINK_BASE
# (supabase secrets set DOC_LINK_BASE=...). Keep the two identical, or a link
# built in the UI will not match one sent over WhatsApp.
VITE_DOC_LINK_BASE=https://your-app-domain.example/r
